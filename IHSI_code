                'Train_sequences': len(X_train),
                'Val_sequences': len(X_val),
                'Test_sequences': len(X_test)
            })

            # ----------------------------
            # Best model selected only by validation RMSE
            # ----------------------------
            if val_metrics['RMSE'] < best_val_rmse:

                best_val_rmse = val_metrics['RMSE']
                best_model_name = name

                best_test_true_raw = test_true_raw.copy()
                best_test_pred_raw = test_pred_raw.copy()
                best_true_levels = true_levels.copy()
                best_pred_levels = pred_levels.copy()
                best_conf_mat = test_conf_mat.copy()
                best_test_risk_acc = test_risk_acc

                best_model_save_path = os.path.join(
                    interval_output_dir,
                    f"best_model_selected_by_valRMSE_{name}_paper4_plus_{agg_tag}_subjectwise.keras"
                )

                model.save(best_model_save_path)

                best_predictions_df = meta_test.copy()
