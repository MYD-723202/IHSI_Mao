                    f"best_model_test_predictions_{agg_tag}.csv"
                )

                best_predictions_df.to_csv(best_predictions_path, index=False, encoding='utf-8-sig')

            del model
            gc.collect()

        except Exception as e:
            print(f"{name} training failed under {agg_tag}: {e}")
            K.clear_session()
            gc.collect()

    results_df = pd.DataFrame(results_data)

