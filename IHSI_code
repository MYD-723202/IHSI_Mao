# CELL 7. Train one aggregation interval
# ===================================================================

def run_one_aggregation_sensitivity(
    df_source,
    aggregation_interval_min,
    train_subjects,
    val_subjects,
    test_subjects
):
    agg_tag = f"{aggregation_interval_min}min"

    interval_output_dir = os.path.join(
        OUTPUT_DIR,
        f"aggregation_{agg_tag}"
    )

    os.makedirs(interval_output_dir, exist_ok=True)

    print("\n" + "#" * 100)
    print(f"Running sensitivity analysis: {agg_tag} aggregation")
    print("#" * 100)

    
    n_lookback_steps = max(1, math.ceil(LOOKBACK_DURATION_MIN / aggregation_interval_min))
    n_forecast_steps = PREDICT_AHEAD_STEPS

    effective_lookback_min = n_lookback_steps * aggregation_interval_min
    effective_forecast_min = n_forecast_steps * aggregation_interval_min

    print("\nEffective sequence settings:")
    print("N_LOOKBACK_STEPS:", n_lookback_steps)
    print("Effective lookback duration:", effective_lookback_min, "min")
    print("N_FORECAST_STEPS:", n_forecast_steps)
    print("Effective forecast horizon:", effective_forecast_min, "min")

    
    df_clean, feature_names, processing_meta = process_data_paper4_plus_flexible_aggregation_no_scaling(
        df_source,
        aggregation_interval_min=aggregation_interval_min,
        output_dir=interval_output_dir
    )

    df_train, df_val, df_test = split_by_fixed_subject_sets(
        df_clean,
        train_subjects,
        val_subjects,
        test_subjects
    )

    df_train_scaled, df_val_scaled, df_test_scaled, scaler_x, scaler_y = fit_transform_scalers(
        df_train,
        df_val,
        df_test,
        feature_names
    )

    print("\n========== Creating sequences ==========")

    X_train, y_train, meta_train = create_sequences_by_subject_segment(
        df_train_scaled,
        n_lookback_steps,
        n_forecast_steps,
        feature_names
    )

    X_val, y_val, meta_val = create_sequences_by_subject_segment(
        df_val_scaled,
        n_lookback_steps,
        n_forecast_steps,
        feature_names
    )

    X_test, y_test, meta_test = create_sequences_by_subject_segment(
        df_test_scaled,
        n_lookback_steps,
        n_forecast_steps,
        feature_names
    )

    print("X_train:", X_train.shape, "y_train:", y_train.shape)
