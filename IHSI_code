# Common data entry point for manuscript plotting sections
import os
from pathlib import Path
import numpy as np
import pandas as pd

DATA_PATH = Path(os.environ.get("IHSI_DATA_PATH", "deidentified_data.csv"))
FIGURE_DIR = Path(os.environ.get("IHSI_OUTPUT_DIR", "outputs_manuscript_figures"))
FIGURE_DIR.mkdir(parents=True, exist_ok=True)

if not DATA_PATH.exists():
    raise FileNotFoundError(
        f"Data not found: {DATA_PATH}. Set IHSI_DATA_PATH to the de-identified input data."
    )

if DATA_PATH.suffix.lower() == ".csv":
    for encoding in ("utf-8-sig", "utf-8", "gb18030", "gbk"):
        try:
            df = pd.read_csv(DATA_PATH, encoding=encoding, low_memory=False)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise ValueError("CSV encoding could not be identified.")
elif DATA_PATH.suffix.lower() in {".xlsx", ".xls"}:
    df = pd.read_excel(DATA_PATH)
elif DATA_PATH.suffix.lower() in {".pkl", ".pickle"}:
    df = pd.read_pickle(DATA_PATH)
else:
    raise ValueError("Input must be CSV, XLSX, XLS, PKL, or PICKLE.")

df.columns = [str(col).strip() for col in df.columns]
alias_map = {
    "petco2": "etco2",
    "respiratory_rate": "respiratory rate",
    "hr": "pulse",
    "total_score": "total score",
    "unnatural movements?": "unnatural movements",
}
for original, alias in alias_map.items():
    if original in df.columns and alias not in df.columns:
        df[alias] = df[original]

temp_data = df.dropna(subset=["Temperature_x", "ta"]).copy()
rh_data = df.dropna(subset=["rh"]).copy()
