def split_by_fixed_subject_sets(df_clean, train_subjects, val_subjects, test_subjects):
    df_train = df_clean[df_clean['subject_id'].isin(train_subjects)].copy()
    df_val = df_clean[df_clean['subject_id'].isin(val_subjects)].copy()
    df_test = df_clean[df_clean['subject_id'].isin(test_subjects)].copy()

    print("\n========== Fixed split check ==========")
    print(f"Train rows: {len(df_train)}, subjects: {df_train['subject_id'].nunique()}")
    print(f"Val rows:   {len(df_val)}, subjects: {df_val['subject_id'].nunique()}")
    print(f"Test rows:  {len(df_test)}, subjects: {df_test['subject_id'].nunique()}")

    assert len(set(df_train['subject_id']) & set(df_val['subject_id'])) == 0
    assert len(set(df_train['subject_id']) & set(df_test['subject_id'])) == 0
    assert len(set(df_val['subject_id']) & set(df_test['subject_id'])) == 0

    return df_train, df_val, df_test


def fit_transform_scalers(df_train, df_val, df_test, feature_names):
    scaler_x = MinMaxScaler()
    scaler_y = MinMaxScaler()

    df_train_scaled = df_train.copy()
    df_val_scaled = df_val.copy()
    df_test_scaled = df_test.copy()

    X_train_scaled = scaler_x.fit_transform(df_train_scaled[feature_names])
    X_val_scaled = scaler_x.transform(df_val_scaled[feature_names])
    X_test_scaled = scaler_x.transform(df_test_scaled[feature_names])

    y_train_scaled = scaler_y.fit_transform(df_train_scaled[['IHSI']])
    y_val_scaled = scaler_y.transform(df_val_scaled[['IHSI']])
    y_test_scaled = scaler_y.transform(df_test_scaled[['IHSI']])

    df_train_scaled[feature_names] = pd.DataFrame(
        X_train_scaled,
        columns=feature_names,
        index=df_train_scaled.index
    )

    df_val_scaled[feature_names] = pd.DataFrame(
        X_val_scaled,
        columns=feature_names,
        index=df_val_scaled.index
    )

    df_test_scaled[feature_names] = pd.DataFrame(
        X_test_scaled,
        columns=feature_names,
        index=df_test_scaled.index
    )

    df_train_scaled['IHSI'] = y_train_scaled.ravel()
    df_val_scaled['IHSI'] = y_val_scaled.ravel()
    df_test_scaled['IHSI'] = y_test_scaled.ravel()

    print("Scaling check: scaler_x and scaler_y fitted only on train data.")

    return df_train_scaled, df_val_scaled, df_test_scaled, scaler_x, scaler_y


def create_sequences_by_subject_segment(
    data,
    seq_length,
    forecast_horizon,
    feature_names
):
    xs, ys, meta_rows = [], [], []

    required_cols = [
        'subject_id',
        'segment_id',
        'time_minute',
        'IHSI'
    ]

    for col in required_cols:
        if col not in data.columns:
            raise KeyError(f"Sequence construction missing required column: {col}")

    for (sub_id, seg_id), group in data.groupby(['subject_id', 'segment_id']):

        group = group.sort_values('time_minute').copy()

        values_x = group[feature_names].values
        values_y = group['IHSI'].values
        target_times = group['time_minute'].values

        if 'n_base_minutes_per_bin' in group.columns:
            n_base_minutes = group['n_base_minutes_per_bin'].values
        else:
            n_base_minutes = np.full(len(group), np.nan)

        if 'n_raw_records_per_bin' in group.columns:
            n_raw_records = group['n_raw_records_per_bin'].values
        else:
            n_raw_records = np.full(len(group), np.nan)

        if len(values_x) < seq_length + forecast_horizon:
            continue

        for i in range(len(values_x) - seq_length - forecast_horizon + 1):

            target_pos = i + seq_length + forecast_horizon - 1

            xs.append(values_x[i:(i + seq_length)])
            ys.append(values_y[target_pos])

            meta_rows.append({
                'subject_id': sub_id,
                'segment_id': seg_id,
                'sequence_start_time': target_times[i],
                'sequence_end_time': target_times[i + seq_length - 1],
                'target_time': target_times[target_pos],
                'target_n_base_minutes_per_bin': n_base_minutes[target_pos],
                'target_n_raw_records_per_bin': n_raw_records[target_pos]
            })

    X = np.array(xs).astype('float32')
    y = np.array(ys).astype('float32')
    meta_df = pd.DataFrame(meta_rows)

    return X, y, meta_df


