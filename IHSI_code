    # ---------------------------------------------------------------
    # Train seven models
    # ---------------------------------------------------------------
    input_shape = (X_train.shape[1], X_train.shape[2])

    callbacks = [
        ReduceLROnPlateau(
            monitor='val_loss',
            factor=0.5,
            patience=3,
            verbose=0,
            min_lr=0.00001
        ),
        EarlyStopping(
            monitor='val_loss',
            patience=10,
            restore_best_weights=True,
            verbose=0
        )
    ]

    print("\n" + "=" * 90)
    print(f"Training 7 models: paper_4_plus {agg_tag} aggregation")
    print("Model selection criterion: Validation RMSE")
    print("Test set use: final evaluation only")
    print("=" * 90)

    results_data = []

    best_val_rmse = float('inf')
    best_model_name = ""
    best_model_save_path = ""

    best_test_true_raw = None
    best_test_pred_raw = None
    best_true_levels = None
    best_pred_levels = None
    best_conf_mat = None
    best_test_risk_acc = None

    for name in MODEL_LIST:

        print(f"\nTraining: {name:<10}")

        K.clear_session()
        gc.collect()

        random.seed(SEED)
        np.random.seed(SEED)
        tf.random.set_seed(SEED)

        try:
            model = build_model_architecture(name, input_shape)

            history = model.fit(
                X_train,
                y_train,
                epochs=EPOCHS,
                batch_size=BATCH_SIZE,
