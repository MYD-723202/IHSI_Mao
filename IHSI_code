            )

            
            val_pred_scaled = model.predict(X_val, batch_size=BATCH_SIZE, verbose=0)
            val_pred_raw = scaler_y.inverse_transform(val_pred_scaled).reshape(-1)
            val_true_raw = scaler_y.inverse_transform(y_val.reshape(-1, 1)).reshape(-1)

