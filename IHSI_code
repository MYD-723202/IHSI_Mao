    """

    df_tmp = standardize_required_columns(df_raw.copy())
    df_tmp = df_tmp.dropna(subset=['subject_id']).copy()

    groups = df_tmp['subject_id']

    gss_test = GroupShuffleSplit(
        n_splits=1,
        test_size=TEST_SIZE,
        random_state=SEED
    )

    trainval_idx, test_idx = next(gss_test.split(df_tmp, groups=groups))

    df_trainval = df_tmp.iloc[trainval_idx].copy()
    df_test = df_tmp.iloc[test_idx].copy()

    groups_trainval = df_trainval['subject_id']

    gss_val = GroupShuffleSplit(
        n_splits=1,
        test_size=VAL_SIZE_IN_TRAINVAL,
        random_state=SEED
    )

    train_idx_rel, val_idx_rel = next(
        gss_val.split(df_trainval, groups=groups_trainval)
    )

    df_train = df_trainval.iloc[train_idx_rel].copy()
    df_val = df_trainval.iloc[val_idx_rel].copy()

    train_subjects = set(df_train['subject_id'].unique())
    val_subjects = set(df_val['subject_id'].unique())
    test_subjects = set(df_test['subject_id'].unique())

    print("\n========== Fixed subject-wise split ==========")
    print(f"Train subjects: {len(train_subjects)}")
    print(f"Val subjects:   {len(val_subjects)}")
    print(f"Test subjects:  {len(test_subjects)}")

    print("Train/Val overlap:", len(train_subjects & val_subjects))
    print("Train/Test overlap:", len(train_subjects & test_subjects))
    print("Val/Test overlap:", len(val_subjects & test_subjects))

    assert len(train_subjects & val_subjects) == 0
    assert len(train_subjects & test_subjects) == 0
    assert len(val_subjects & test_subjects) == 0

    split_info = pd.DataFrame({
        'subject_id': (
            safe_sorted(train_subjects)
            + safe_sorted(val_subjects)
            + safe_sorted(test_subjects)
        ),
        'split': (
            ['train'] * len(train_subjects)
            + ['val'] * len(val_subjects)
            + ['test'] * len(test_subjects)
        )
    })

    split_path = os.path.join(
        OUTPUT_DIR,
        "fixed_subject_split_for_1_2_5min_sensitivity.csv"
    )

    split_info.to_csv(split_path, index=False, encoding='utf-8-sig')
    print("Fixed subject split saved:", split_path)

    return train_subjects, val_subjects, test_subjects, split_info


