def get_optional_group_cols(df):
    if not USE_SETPOINTS_FOR_GROUPING_IF_AVAILABLE:
        return []

    available = [c for c in SETPOINT_GROUP_COLS if c in df.columns]

    if available:
        print("Setpoint columns used for grouping only:", available)
        print("These columns are not used as model inputs.")

    return available


def process_data_paper4_plus_flexible_aggregation_no_scaling(
    df_input,
    aggregation_interval_min,
    output_dir
):
    

    df_input = standardize_required_columns(df_input.copy())

    required_cols = [
        'subject_id',
        'time',
        'age',
        'bmi',
        'hi',
        'hr',
        'IHSI'
    ]

    missing_cols = [c for c in required_cols if c not in df_input.columns]

    if missing_cols:
        raise ValueError(f"Missing required columns: {missing_cols}")

    agg_tag = f"{aggregation_interval_min}min"

    df_input = df_input.reset_index(drop=False).rename(
        columns={'index': '_original_order'}
    )

    df_input['time'] = pd.to_datetime(df_input['time'], errors='coerce')

    if df_input['time'].isna().any():
        n_bad = df_input['time'].isna().sum()
        raise ValueError(f"time contains {n_bad} invalid datetime values.")

    df_input['time_minute'] = df_input['time'].dt.floor('min')

    for col in ['age', 'bmi', 'hi', 'hr', 'IHSI']:
        df_input[col] = pd.to_numeric(df_input[col], errors='coerce')

    optional_group_cols = get_optional_group_cols(df_input)

    for col in optional_group_cols:
        df_input[col] = pd.to_numeric(df_input[col], errors='coerce')

    sort_cols = ['subject_id'] + optional_group_cols + ['time_minute', '_original_order']

    df_input = df_input.sort_values(
        sort_cols,
        kind='mergesort'
    ).copy()

    print("\n" + "=" * 90)
    print(f"Temporal aggregation interval: {aggregation_interval_min} min")
    print("=" * 90)

    print("Base aggregation: subject_id + optional setpoints + minute timestamp")
    print("Target aggregation: within continuous subject-specific segments")


    base_group_cols = ['subject_id'] + optional_group_cols + ['time_minute']

    minute_count = (
        df_input
        .groupby(base_group_cols)
        .size()
        .reset_index(name='n_raw_records_per_minute')
    )

    minute_count_path = os.path.join(
        output_dir,
        f"minute_record_count_check_base_for_{agg_tag}.csv"
    )

    minute_count.to_csv(minute_count_path, index=False, encoding='utf-8-sig')

    agg_rules_base = {
        'age': 'first',
        'bmi': 'first',
        'hi': 'mean',
        'hr': 'mean',
        'IHSI': 'mean',
        '_original_order': 'min'
    }

    for col in optional_group_cols:
        agg_rules_base[col] = 'first'

    df_min = (
        df_input
        .groupby(base_group_cols, as_index=False)
        .agg(agg_rules_base)
    )

    df_min = df_min.merge(
        minute_count,
        on=base_group_cols,
        how='left'
    )

    df_min = df_min.sort_values(
        ['subject_id'] + optional_group_cols + ['time_minute', '_original_order'],
        kind='mergesort'
    ).copy()

    # ---------------------------------------------------------------
    # B. Segment detection
    # ---------------------------------------------------------------

    segment_group_cols = ['subject_id'] + optional_group_cols

    df_min['minute_gap'] = (
        df_min
        .groupby(segment_group_cols)['time_minute']
        .diff()
        .dt.total_seconds()
        .div(60)
    )

    df_min['new_segment'] = (
        df_min['minute_gap'].isna()
        | (df_min['minute_gap'] > 1.5)
    )

    df_min['segment_id_local'] = (
        df_min
        .groupby(segment_group_cols)['new_segment']
        .cumsum()
        .astype(int)
    )

    # Make segment_id globally unique enough for grouping.
    df_min['segment_key'] = (
        df_min[segment_group_cols].astype(str).agg('_'.join, axis=1)
        + '_seg'
        + df_min['segment_id_local'].astype(str)
    )

    # Keep numeric segment_id for compatibility.
    df_min['segment_id'] = pd.factorize(df_min['segment_key'])[0] + 1

    segment_check = (
        df_min
        .groupby(['subject_id'])['segment_id']
        .nunique()
        .reset_index(name='n_segments')
    )

    segment_check_path = os.path.join(
        output_dir,
        f"subject_segment_check_{agg_tag}.csv"
    )

    segment_check.to_csv(segment_check_path, index=False, encoding='utf-8-sig')

    # ---------------------------------------------------------------
    # C. Target interval aggregation
    # ---------------------------------------------------------------

    df_min['minute_index_in_segment'] = (
        df_min
        .groupby(['subject_id', 'segment_id'])
        .cumcount()
    )

    df_min['agg_bin_id'] = (
        df_min['minute_index_in_segment'] // aggregation_interval_min
    ).astype(int)

    bin_group_cols = ['subject_id', 'segment_id', 'agg_bin_id']

    bin_count = (
        df_min
        .groupby(bin_group_cols)
        .agg(
            n_base_minutes_per_bin=('IHSI', 'size'),
            n_raw_records_per_bin=('n_raw_records_per_minute', 'sum')
        )
        .reset_index()
    )

    bin_quality_path = os.path.join(
        output_dir,
        f"aggregation_bin_quality_{agg_tag}.csv"
    )

    bin_count.to_csv(bin_quality_path, index=False, encoding='utf-8-sig')

    agg_rules_target = {
        'time_minute': 'first',
        'age': 'first',
        'bmi': 'first',
        'hi': 'mean',
        'hr': 'mean',
        'IHSI': 'mean',
        '_original_order': 'min'
    }

    for col in optional_group_cols:
        agg_rules_target[col] = 'first'

    df = (
        df_min
        .groupby(bin_group_cols, as_index=False)
        .agg(agg_rules_target)
    )

    df = df.merge(
        bin_count,
        on=bin_group_cols,
        how='left'
    )

    df = df.sort_values(
        ['subject_id', 'segment_id', 'agg_bin_id'],
        kind='mergesort'
    ).copy()

    print("1-min base rows:", len(df_min))
    print(f"{aggregation_interval_min}-min aggregated rows:", len(df))
    print("Bin quality saved:", bin_quality_path)

    # ---------------------------------------------------------------
    # D. paper_4
    # ---------------------------------------------------------------

    group_keys = ['subject_id', 'segment_id']

    roll3_steps = max(1, math.ceil(3 / aggregation_interval_min))
    roll5_steps = max(1, math.ceil(5 / aggregation_interval_min))

    actual_roll3_min = roll3_steps * aggregation_interval_min
    actual_roll5_min = roll5_steps * aggregation_interval_min

    print("\nRolling-window settings:")
    print(f"3-min rolling feature uses {roll3_steps} steps ≈ {actual_roll3_min} min")
    print(f"5-min rolling feature uses {roll5_steps} steps ≈ {actual_roll5_min} min")

    df['hr_diff'] = df.groupby(group_keys)['hr'].diff().fillna(0)
    df['hi_diff'] = df.groupby(group_keys)['hi'].diff().fillna(0)

    df['hr_roll_mean_3min'] = (
        df.groupby(group_keys)['hr']
        .transform(lambda s: s.rolling(window=roll3_steps, min_periods=1).mean())
    )

    df['hr_roll_mean_5min'] = (
        df.groupby(group_keys)['hr']
        .transform(lambda s: s.rolling(window=roll5_steps, min_periods=1).mean())
    )

    df['hi_roll_mean_3min'] = (
        df.groupby(group_keys)['hi']
        .transform(lambda s: s.rolling(window=roll3_steps, min_periods=1).mean())
    )

    df['hi_roll_mean_5min'] = (
        df.groupby(group_keys)['hi']
        .transform(lambda s: s.rolling(window=roll5_steps, min_periods=1).mean())
    )

    df['hr_roll_std_5min'] = (
        df.groupby(group_keys)['hr']
        .transform(lambda s: s.rolling(window=roll5_steps, min_periods=1).std())
        .fillna(0)
    )

    df['hi_roll_std_5min'] = (
        df.groupby(group_keys)['hi']
        .transform(lambda s: s.rolling(window=roll5_steps, min_periods=1).std())
        .fillna(0)
    )

    # Time-weighted cumulative terms.
    df['hr_excess'] = (df['hr'] - 60).clip(lower=0)

    df['cumulative_hr_load'] = (
        df.groupby(group_keys)['hr_excess']
        .transform(lambda s: (s * aggregation_interval_min).cumsum())
    )

    df['cumulative_hi_load'] = (
        df.groupby(group_keys)['hi']
        .transform(lambda s: (s * aggregation_interval_min).cumsum())
    )

    df['hr_hi_interaction'] = df['hr'] * df['hi']
    df['bmi_hr_interaction'] = df['bmi'] * df['hr']
    df['bmi_hi_interaction'] = df['bmi'] * df['hi']
    df['age_hr_interaction'] = df['age'] * df['hr']
    df['age_hi_interaction'] = df['age'] * df['hi']

    df['hr_sq'] = df['hr'] ** 2
    df['hi_sq'] = df['hi'] ** 2

    feature_names = [
        'hr',
        'hi',
        'age',
        'bmi',

        'hr_diff',
        'hi_diff',

        'hr_roll_mean_3min',
        'hr_roll_mean_5min',
        'hi_roll_mean_3min',
        'hi_roll_mean_5min',

        'hr_roll_std_5min',
        'hi_roll_std_5min',

        'cumulative_hr_load',
        'cumulative_hi_load',

        'hr_hi_interaction',
        'bmi_hr_interaction',
        'bmi_hi_interaction',
        'age_hr_interaction',
        'age_hi_interaction',

        'hr_sq',
        'hi_sq'
    ]

    feature_names = list(dict.fromkeys(feature_names))

    df_clean = df.dropna(subset=feature_names + ['IHSI']).copy()

    feature_path = os.path.join(
        output_dir,
        f"input_features_paper4_plus_{agg_tag}.txt"
    )

    with open(feature_path, 'w', encoding='utf-8') as f:
        for feature in feature_names:
            f.write(feature + '\n')

    processing_summary = pd.DataFrame({
        'Item': [
            'Aggregation interval',
            'Rows after target aggregation',
            'Feature count',
            'Rolling 3min steps',
            'Rolling 3min actual duration',
            'Rolling 5min steps',
            'Rolling 5min actual duration',
            'Grouping uses setpoint columns',
            'Setpoint grouping columns'
        ],
        'Value': [
            aggregation_interval_min,
            len(df_clean),
            len(feature_names),
            roll3_steps,
            actual_roll3_min,
            roll5_steps,
            actual_roll5_min,
            USE_SETPOINTS_FOR_GROUPING_IF_AVAILABLE,
            ', '.join(optional_group_cols)
        ]
    })

    processing_summary_path = os.path.join(
        output_dir,
        f"processing_summary_{agg_tag}.csv"
    )

    processing_summary.to_csv(processing_summary_path, index=False, encoding='utf-8-sig')

    print("Feature count:", len(feature_names))
    print("Clean data shape:", df_clean.shape)
    print("Processing summary saved:", processing_summary_path)

    return df_clean, feature_names, {
        'roll3_steps': roll3_steps,
        'roll5_steps': roll5_steps,
        'actual_roll3_min': actual_roll3_min,
        'actual_roll5_min': actual_roll5_min,
        'optional_group_cols': optional_group_cols
    }


