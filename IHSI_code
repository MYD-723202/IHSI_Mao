def evaluate_regression(y_true, y_pred):
    y_true = np.asarray(y_true).reshape(-1)
    y_pred = np.asarray(y_pred).reshape(-1)

    r2 = r2_score(y_true, y_pred)
    mae = mean_absolute_error(y_true, y_pred)
    rmse = math.sqrt(mean_squared_error(y_true, y_pred))
    mape = np.mean(np.abs((y_true - y_pred) / (np.abs(y_true) + 1e-5))) * 100

    return {
        'R2': r2,
        'MAE': mae,
        'RMSE': rmse,
        'MAPE (%)': mape
    }


def classify_risk(ihsi_value, thresholds=RISK_THRESHOLDS):
    if ihsi_value < thresholds[0]:
        return 0
    elif ihsi_value < thresholds[1]:
        return 1
    elif ihsi_value < thresholds[2]:
        return 2
    elif ihsi_value < thresholds[3]:
        return 3
    else:
        return 4


def evaluate_risk_levels(y_true, y_pred):
    true_levels = np.array([classify_risk(v) for v in np.asarray(y_true).reshape(-1)])
    pred_levels = np.array([classify_risk(v) for v in np.asarray(y_pred).reshape(-1)])

    risk_acc = accuracy_score(true_levels, pred_levels)

    conf_mat = confusion_matrix(
        true_levels,
        pred_levels,
        labels=[0, 1, 2, 3, 4]
    )

    return true_levels, pred_levels, risk_acc, conf_mat


