                f"MAPE={val_metrics['MAPE (%)']:.2f}%, "
                f"RiskAcc={val_risk_acc * 100:.2f}%"
            )

            print(
                f"Test:       R²={test_metrics['R2']:.3f}, "
                f"MAE={test_metrics['MAE']:.2f}, "
                f"RMSE={test_metrics['RMSE']:.2f}, "
                f"MAPE={test_metrics['MAPE (%)']:.2f}%, "
                f"RiskAcc={test_risk_acc * 100:.2f}%"
            )

            results_data.append({
                'Aggregation_min': aggregation_interval_min,
                'Aggregation_label': agg_tag,

                'Model': name,

                'Val_R2': val_metrics['R2'],
                'Val_MAE': val_metrics['MAE'],
                'Val_RMSE': val_metrics['RMSE'],
                'Val_MAPE (%)': val_metrics['MAPE (%)'],
                'Val_RiskAcc': val_risk_acc,

                'Test_R2': test_metrics['R2'],
