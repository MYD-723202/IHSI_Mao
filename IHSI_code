def run(data_path, outdir, participant_col=None, round_col=None):
    raw = read_data(data_path)
    participant_votes = prepare_participant_votes(raw, participant_col, round_col)
    _, summary = summarize_votes(participant_votes)
    outdir = Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    summary.to_csv(outdir / "Figure_5_summary_statistics.csv", index=False, encoding="utf-8-sig")
    fig = plot_figure5(summary)
    export_figure(fig, outdir)
    plt.close(fig)
    return summary


def main():
    parser = argparse.ArgumentParser(description="Reproduce final manuscript Figure 5.")
    parser.add_argument("--data", required=True, help="De-identified CSV/XLSX/PKL input data.")
    parser.add_argument("--outdir", default="outputs_figure5")
    parser.add_argument("--participant-col", default=None)
    parser.add_argument("--round-col", default=None)
    args = parser.parse_args()
    summary = run(args.data, args.outdir, args.participant_col, args.round_col)
    print(f"Figure 5 exported to: {Path(args.outdir).resolve()}")
    print(f"Summary rows: {len(summary)}")


if __name__ == "__main__":
