def table2_coefficients(df, args):
    construction = df[df["phase_clean"].isin(["preparation", "exercise"])].copy()
    construction["construction_label"] = (construction["phase_clean"] == "exercise").astype(int)
    construction = construction.dropna(subset=["construction_label", *FEATURE_COLUMNS]).copy()

    x_raw = construction[FEATURE_COLUMNS].astype(float)
    y = construction["construction_label"].astype(int)

    minmax = MinMaxScaler()
    x_minmax = minmax.fit_transform(x_raw)
    model_formula = LogisticRegression(
        penalty="l2",
        C=1.0,
        random_state=RANDOM_STATE,
        max_iter=5000,
        class_weight="balanced",
    )
    model_formula.fit(x_minmax, y)

    standard = StandardScaler()
    x_std = standard.fit_transform(x_raw)
    model_standard = LogisticRegression(
        penalty="l2",
        C=1.0,
        random_state=RANDOM_STATE,
        max_iter=5000,
        class_weight="balanced",
    )
    model_standard.fit(x_std, y)

    x_vif = add_constant(x_raw)
    vif = pd.Series(
        [variance_inflation_factor(x_vif.values, i) for i in range(x_vif.shape[1])],
        index=x_vif.columns,
    ).drop("const", errors="ignore")

    table = pd.DataFrame(
        {
            "Parameters (Variables)": FEATURE_COLUMNS,
            "Coefficient (Beta)": model_formula.coef_[0],
            "Standardized Coeff.": model_standard.coef_[0],
            "VIF": [vif.get(col, np.nan) for col in FEATURE_COLUMNS],
        }
    )
    intercept = pd.DataFrame(
        {
            "Parameters (Variables)": ["Constant (Intercept)"],
            "Coefficient (Beta)": [model_formula.intercept_[0]],
            "Standardized Coeff.": [np.nan],
            "VIF": [np.nan],
        }
    )
    table = table.sort_values(
        by="Coefficient (Beta)", key=lambda s: s.abs(), ascending=False
    )
    return pd.concat([intercept, table], ignore_index=True)


