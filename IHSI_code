def normalize_subject_id(x):
    if pd.isna(x):
        return np.nan

    try:
        v = float(x)
        if v.is_integer():
            return str(int(v))
    except Exception:
        pass

    return str(x).strip()


def safe_sorted(values):
    try:
        return sorted(list(values), key=lambda x: int(float(x)) if str(x).replace('.', '', 1).isdigit() else str(x))
    except Exception:
        return list(values)


def standardize_required_columns(df):
    """
    Standardize core column names:
    subject_id, time, age, bmi, hi, hr, IHSI
    """

    df = df.copy()

    candidates = {
        'subject_id': ['subject_id', 'subject id', 'subject', 'id'],
        'time': ['time', 'timestamp', 'datetime', 'time(min)', 'Time', 'Time(min)'],
        'age': ['age'],
        'bmi': ['bmi'],
        'hi': ['hi'],
        'hr': ['hr'],
        'IHSI': ['IHSI', 'ihsi', 'ihsi_corrected']
    }

    lower_to_original = {
        str(col).strip().lower(): col
        for col in df.columns
    }

    rename_map = {}

    for target, cand_list in candidates.items():
        if target in df.columns:
            continue

        found = None

        for cand in cand_list:
            cand_lower = str(cand).strip().lower()
            if cand_lower in lower_to_original:
                found = lower_to_original[cand_lower]
                break

        if found is not None:
            rename_map[found] = target

    if rename_map:
        df = df.rename(columns=rename_map)

    required_cols = ['subject_id', 'time', 'age', 'bmi', 'hi', 'hr', 'IHSI']
    missing_cols = [c for c in required_cols if c not in df.columns]

    if missing_cols:
        raise ValueError(f"Missing required columns: {missing_cols}")

    df['subject_id'] = df['subject_id'].apply(normalize_subject_id)

    return df


