def fit_predict(train_df, test_df):
    scaler = MinMaxScaler()
    x_train = scaler.fit_transform(train_df[FEATURE_COLUMNS].astype(float))
    x_test = scaler.transform(test_df[FEATURE_COLUMNS].astype(float))
    y_train = train_df["is_at_risk_explicit"].astype(int)

    model = LogisticRegression(
        penalty="l2",
        C=1.0,
        random_state=RANDOM_STATE,
        max_iter=5000,
        class_weight="balanced",
    )
    model.fit(x_train, y_train)
    y_score = model.predict_proba(x_test)[:, 1]
    y_pred = (y_score >= DECISION_THRESHOLD).astype(int)
    return model, scaler, y_score, y_pred


