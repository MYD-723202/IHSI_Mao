        test_df = df_eval.iloc[test_idx].copy()
        model, scaler, y_score, y_pred = fit_predict(train_df, test_df)
        y_true = test_df["is_at_risk_explicit"].astype(int).to_numpy()
        row = metrics_from_predictions(y_true, y_score, y_pred)
        row.update(
            {
                "fold": fold,
                "train_subjects": train_df["participant_id"].nunique(),
                "test_subjects": test_df["participant_id"].nunique(),
            }
        )
        rows.append(row)

        pred = test_df[["participant_id", "phase_clean"]].copy()
        pred["fold"] = fold
        pred["y_true"] = y_true
        pred["y_score"] = y_score
        pred["y_pred"] = y_pred
        predictions.append(pred)

    metrics = pd.DataFrame(rows)
    summary_rows = []
    for col in ["AUC", "AP", "Accuracy", "Balanced accuracy", "Precision", "Recall", "F1"]:
        summary_rows.append(
            {
                "metric": col,
                "mean": metrics[col].mean(),
                "sd": metrics[col].std(ddof=1),
                "mean_sd": f"{metrics[col].mean():.4f} +/- {metrics[col].std(ddof=1):.4f}",
            }
        )
    return metrics, pd.DataFrame(summary_rows), pd.concat(predictions, ignore_index=True)


def supplementary_inference(df_eval):
    x_scaled = pd.DataFrame(
        MinMaxScaler().fit_transform(df_eval[FEATURE_COLUMNS].astype(float)),
        columns=FEATURE_COLUMNS,
        index=df_eval.index,
    )
    x_design = sm.add_constant(x_scaled, has_constant="add")
    y = df_eval["is_at_risk_explicit"].astype(int)
    groups = df_eval["participant_id"].astype(str)
    rows = []

    glm = sm.GLM(y, x_design, family=sm.families.Binomial())
    glm_res = glm.fit(cov_type="cluster", cov_kwds={"groups": groups})
    ci = glm_res.conf_int()
    for name in glm_res.params.index:
        rows.append(
            {
                "model": "glm_cluster_robust_by_subject",
                "parameter": name,
                "coef": glm_res.params[name],
                "se": glm_res.bse[name],
                "z": glm_res.tvalues[name],
                "p_value": glm_res.pvalues[name],
                "ci_low": ci.loc[name, 0],
                "ci_high": ci.loc[name, 1],
            }
        )

    gee = sm.GEE(
        y,
        x_design,
        groups=groups,
        family=sm.families.Binomial(),
        cov_struct=sm.cov_struct.Exchangeable(),
    )
    gee_res = gee.fit()
    ci = gee_res.conf_int()
    for name in gee_res.params.index:
        rows.append(
            {
                "model": "gee_exchangeable_by_subject",
                "parameter": name,
                "coef": gee_res.params[name],
                "se": gee_res.bse[name],
                "z": gee_res.tvalues[name],
                "p_value": gee_res.pvalues[name],
                "ci_low": ci.loc[name, 0],
                "ci_high": ci.loc[name, 1],
            }
        )
    return pd.DataFrame(rows)


