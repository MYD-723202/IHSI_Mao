def format_condition_title(temp_level, wind_level):
    return f"{temp_level}°C + {wind_level} m/s"


def get_manual_window(temp_level, wind_level):

    key = (temp_level, wind_level)

    if key not in MANUAL_SELECTED_CASES:
        raise KeyError(f"MANUAL_SELECTED_CASES lack this case: {key}")

    info = MANUAL_SELECTED_CASES[key]

    sub_id_target = normalize_id_as_str(info["subject_id"])
    seg_id_target = int(info["segment_id"])
    start_index = int(info.get("start_index", FIG12_STYLE["default_start_index"]))

    df_tmp = df_clean_final.copy()

    df_tmp["subject_id_str"] = df_tmp["subject_id"].apply(normalize_id_as_str)
    df_tmp["segment_id_int"] = pd.to_numeric(df_tmp["segment_id"], errors="coerce").astype("Int64")

    df_tmp["temperature_x_round"] = pd.to_numeric(
        df_tmp["temperature_x"],
        errors="coerce"
    ).round().astype("Int64")

    df_tmp["movement_speed_round"] = pd.to_numeric(
        df_tmp["movement_speed"],
        errors="coerce"
    ).round(1)

    df_case = df_tmp[
        (df_tmp["temperature_x_round"] == int(temp_level))
        & (np.isclose(df_tmp["movement_speed_round"], float(wind_level), atol=0.05))
        & (df_tmp["subject_id_str"] == sub_id_target)
        & (df_tmp["segment_id_int"] == seg_id_target)
    ].copy()

    df_case = df_case.sort_values("time_minute").reset_index(drop=True)

    if len(df_case) < PLOT_LENGTH:
        raise RuntimeError(
            f"{temp_level}°C + {wind_level} m/s | Sub {sub_id_target}, Seg {seg_id_target} "
            f" {len(df_case)} ， {PLOT_LENGTH} "
        )

    if start_index + PLOT_LENGTH > len(df_case):
        raise RuntimeError(
            f"{temp_level}°C + {wind_level} m/s | Sub {sub_id_target}, Seg {seg_id_target} "
            f"start_index={start_index}  {PLOT_LENGTH} "
        )

    df_window = df_case.iloc[start_index:start_index + PLOT_LENGTH].copy().reset_index(drop=True)

    return df_window, {
        "temp_level": temp_level,
        "wind_level": wind_level,
        "subject_id": sub_id_target,
        "segment_id": seg_id_target,
        "start_index": start_index,
        "start_time": df_window["time_minute"].iloc[0],
        "end_time": df_window["time_minute"].iloc[-1],
        "n_rows": len(df_window)
    }


def predict_manual_window_top3(df_window):
   
    df_window = df_window.copy().reset_index(drop=True)

    if len(df_window) != PLOT_LENGTH:
        return None

    X_data = df_window[feature_names_final].copy()
    y_true = df_window["IHSI"].values.astype(float)

    X_scaled = scaler_x_final.transform(X_data)

    xs = []
    target_indices = []

    for k in range(len(X_scaled) - FINAL_N_LOOKBACK - FINAL_N_FORECAST + 1):
        xs.append(X_scaled[k:k + FINAL_N_LOOKBACK])
        target_indices.append(k + FINAL_N_LOOKBACK + FINAL_N_FORECAST - 1)

    if len(xs) == 0:
        return None

    X_input = np.array(xs).astype("float32")

    pred_display = {}
    pred_valid = {}

    for model_name in TOP3_NAMES_FINAL:
        model = trained_top3_model_dict_final[model_name]

        pred_scaled = model.predict(X_input, verbose=0)
        y_pred = scaler_y_final.inverse_transform(pred_scaled).reshape(-1)

        full_pred = np.full(PLOT_LENGTH, np.nan)
        full_pred[target_indices] = y_pred

       
        first_valid_idx = target_indices[0]
        full_pred[:first_valid_idx] = y_pred[0]

        pred_display[model_name] = full_pred
        pred_valid[model_name] = {
            "target_indices": np.array(target_indices),
            "y_pred_valid": y_pred
        }

    return {
        "x": np.arange(PLOT_LENGTH),
        "y_true": y_true,
        "pred_display": pred_display,
        "pred_valid": pred_valid,
        "target_indices": np.array(target_indices)
    }


def summarize_manual_case(df_window, pred_result):
   

    y_true = pred_result["y_true"]
    target_indices = pred_result["target_indices"]
    true_valid = y_true[target_indices]

    out = {
        "true_min": float(np.min(y_true)),
        "true_max": float(np.max(y_true)),
        "true_range": float(np.max(y_true) - np.min(y_true)),
        "true_mean": float(np.mean(y_true)),
        "true_std": float(np.std(y_true)),
        "first10_mean": float(np.mean(y_true[:10])),
        "last10_mean": float(np.mean(y_true[-10:])),
        "peak_index": int(np.argmax(y_true)),
        "peak_value": float(np.max(y_true)),
    }

    for model_name in TOP3_NAMES_FINAL:
        y_pred_valid = pred_result["pred_valid"][model_name]["y_pred_valid"]

        rmse = np.sqrt(np.mean((true_valid - y_pred_valid) ** 2))
        mae = np.mean(np.abs(true_valid - y_pred_valid))

        if np.std(true_valid) > 1e-6 and np.std(y_pred_valid) > 1e-6:
            corr = np.corrcoef(true_valid, y_pred_valid)[0, 1]
        else:
            corr = np.nan

        out[f"{model_name}_RMSE"] = float(rmse)
        out[f"{model_name}_MAE"] = float(mae)
        out[f"{model_name}_Corr"] = float(corr)

    return out


