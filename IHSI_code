            _, _, val_risk_acc, val_conf_mat = evaluate_risk_levels(
                val_true_raw,
                val_pred_raw
            )

            
            test_pred_scaled = model.predict(X_test, batch_size=BATCH_SIZE, verbose=0)
            test_pred_raw = scaler_y.inverse_transform(test_pred_scaled).reshape(-1)
            test_true_raw = scaler_y.inverse_transform(y_test.reshape(-1, 1)).reshape(-1)

            test_metrics = evaluate_regression(test_true_raw, test_pred_raw)
            true_levels, pred_levels, test_risk_acc, test_conf_mat = evaluate_risk_levels(
                test_true_raw,
                test_pred_raw
            )

            print(
                f"Validation: R²={val_metrics['R2']:.3f}, "
