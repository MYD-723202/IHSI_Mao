        n_splits=1,
        test_size=args.test_size,
        random_state=RANDOM_STATE,
    )
    groups = df_eval["participant_id"].astype(str)
    train_idx, test_idx = next(
        splitter.split(df_eval[FEATURE_COLUMNS], df_eval["is_at_risk_explicit"], groups=groups)
    )

    train_df = df_eval.iloc[train_idx].copy()
    test_df = df_eval.iloc[test_idx].copy()
    overlap = set(train_df["participant_id"]) & set(test_df["participant_id"])
    if overlap:
        raise ValueError(f"Participant-level leakage detected: {sorted(overlap)}")

    model, scaler, y_score, y_pred = fit_predict(train_df, test_df)
    y_true = test_df["is_at_risk_explicit"].astype(int).to_numpy()
    metrics = metrics_from_predictions(y_true, y_score, y_pred)
    metrics.update(
        {
            "Total samples": len(df_eval),
            "Train samples": len(train_df),
            "Test samples": len(test_df),
            "Train participants": train_df["participant_id"].nunique(),
            "Test participants": test_df["participant_id"].nunique(),
            "Overlapped participants": len(overlap),
        }
    )

