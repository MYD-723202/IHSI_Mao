import argparse
from pathlib import Path

import matplotlib as mpl
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from matplotlib.patches import Rectangle
import numpy as np
import pandas as pd


TEMPERATURES = (31.0, 34.0, 37.0)
SPEEDS = (1.1, 1.5, 1.9)
TIME_POINTS = tuple(range(0, 101, 10))

METRICS = (
    ("overall_tsv", "TSV", (-2.2, 5.0), np.arange(-2, 6, 1)),
    ("overall_hsv", "HSV", (-2.2, 3.3), np.arange(-2, 4, 1)),
    ("overall_msv", "MSV", (-3.2, 3.2), np.arange(-3, 4, 1)),
    ("skin wetness level", "Skin wetness level", (0.8, 5.2), np.arange(1, 6, 1)),
)

COLORS = {1.1: "#1B9E77", 1.5: "#D95F02", 1.9: "#7570B3"}
OFFSETS = {1.1: -2.0, 1.5: 0.0, 1.9: 2.0}
PHASE_SPANS = (
    (0, 30, "#E8F4F1"),
    (30, 70, "#FAEEE8"),
    (70, 100, "#EEF0F7"),
)


def choose_column(columns, candidates, role):
    """Find a required column using exact and normalized aliases."""
    columns = list(columns)
    for candidate in candidates:
        if candidate in columns:
            return candidate
    normalized = {
        str(col).strip().lower().replace("_", "").replace(" ", ""): col
        for col in columns
    }
    for candidate in candidates:
        key = candidate.strip().lower().replace("_", "").replace(" ", "")
        if key in normalized:
            return normalized[key]
    raise KeyError(f"Could not identify the {role} column. Tried: {candidates}")


def read_data(path):
    """Read CSV, Excel, or pickle input without assuming a private path."""
    path = Path(path)
    suffix = path.suffix.lower()
    if suffix == ".csv":
        for encoding in ("utf-8-sig", "utf-8", "gb18030", "gbk"):
            try:
                return pd.read_csv(path, encoding=encoding, low_memory=False)
            except UnicodeDecodeError:
                continue
        raise ValueError("CSV encoding could not be identified.")
    if suffix in {".xlsx", ".xls"}:
        return pd.read_excel(path)
    if suffix in {".pkl", ".pickle"}:
        return pd.read_pickle(path)
    raise ValueError("Input must be CSV, XLSX, XLS, PKL, or PICKLE.")


def prepare_participant_votes(df, participant_col=None, round_col=None):
    """Collapse repeated high-frequency rows to one value per participant/vote round."""
    df = df.copy()
    df.columns = [str(col).strip() for col in df.columns]

    participant_col = participant_col or choose_column(
        df.columns,
        ["participant_id", "subject_id", "participant_key", "subject_code"],
        "de-identified participant",
    )
    round_col = round_col or choose_column(
        df.columns,
        ["vote_round", "questionnaire_round", "survey_round", "次数"],
        "subjective-vote round",
    )
    temperature_col = choose_column(
        df.columns, ["Temperature_x", "temperature", "temperature_setted"], "temperature"
    )
    speed_col = choose_column(
        df.columns, ["movement speed", "movement_speed", "speed_setted", "speed"], "speed"
    )

    metric_sources = {}
    for standard, _, _, _ in METRICS:
        aliases = {
            "overall_tsv": ["overall_tsv", "TSV", "overall TSV"],
            "overall_hsv": ["overall_hsv", "HSV", "overall HSV"],
            "overall_msv": ["overall_msv", "MSV", "overall MSV"],
            "skin wetness level": [
                "skin wetness level", "skin_wetness_level", "Skin wetness level"
            ],
        }[standard]
        metric_sources[standard] = choose_column(df.columns, aliases, standard)

    selected = [participant_col, round_col, temperature_col, speed_col, *metric_sources.values()]
    work = df[selected].copy()
    work = work.rename(
        columns={
            participant_col: "participant_id",
            round_col: "vote_round",
            temperature_col: "temperature",
            speed_col: "speed",
            **{source: standard for standard, source in metric_sources.items()},
        }
    )

    numeric_cols = ["vote_round", "temperature", "speed", *[m[0] for m in METRICS]]
    for col in numeric_cols:
        work[col] = pd.to_numeric(work[col], errors="coerce")
    work = work.dropna(subset=["participant_id", "vote_round", "temperature", "speed"])
    work = work[
        work["temperature"].isin(TEMPERATURES)
        & work["speed"].isin(SPEEDS)
        & work["vote_round"].between(1, 11)
    ].copy()
    work["time_min"] = (work["vote_round"].round().astype(int) - 1) * 10

    participant_votes = (
        work.groupby(
            ["participant_id", "temperature", "speed", "vote_round", "time_min"],
            observed=True,
            as_index=False,
        )[[m[0] for m in METRICS]]
        .mean()
    )
    return participant_votes


def summarize_votes(participant_votes):
    """Calculate the plotted participant-level statistics."""
    long = participant_votes.melt(
        id_vars=["participant_id", "temperature", "speed", "vote_round", "time_min"],
        value_vars=[m[0] for m in METRICS],
        var_name="metric",
        value_name="score",
    ).dropna(subset=["score"])

    summary = (
        long.groupby(["metric", "temperature", "speed", "time_min"], observed=True)["score"]
        .agg(
            mean="mean",
            q1=lambda x: x.quantile(0.25),
            median="median",
            q3=lambda x: x.quantile(0.75),
            minimum="min",
            maximum="max",
            n="count",
        )
        .reset_index()
    )
    return long, summary


def configure_style():
    mpl.rcParams.update(
        {
            "font.family": "serif",
            "font.serif": ["Times New Roman", "DejaVu Serif"],
            "font.size": 16,
            "axes.linewidth": 0.8,
            "axes.unicode_minus": False,
            "svg.fonttype": "none",
            "pdf.fonttype": 42,
            "ps.fonttype": 42,
        }
    )


def draw_interval(ax, row, speed):
    """Draw Q1-Q3 rectangle, min-max whisker, and end caps."""
    color = COLORS[speed]
    x = float(row["time_min"]) + OFFSETS[speed]
    q1, q3 = float(row["q1"]), float(row["q3"])
    low, high = float(row["minimum"]), float(row["maximum"])
    ax.add_patch(
        Rectangle(
            (x - 0.70, q1), 1.40, max(q3 - q1, 0.015),
            facecolor=color, edgecolor=color, linewidth=0.75, alpha=0.20, zorder=1.5,
        )
    )
    ax.vlines(x, low, high, color=color, linewidth=0.9, alpha=0.92, zorder=2)
    ax.hlines([low, high], x - 0.72, x + 0.72, color=color, linewidth=0.9, zorder=2)


def plot_figure5(summary):
    """Create the final single Figure 5 (no a/b subdivision)."""
    configure_style()
    fig, axes = plt.subplots(4, 3, figsize=(15.8, 15.8), sharex=True, sharey="row")

    for row_idx, (metric, label, ylim, yticks) in enumerate(METRICS):
        for col_idx, temperature in enumerate(TEMPERATURES):
            ax = axes[row_idx, col_idx]
            for start, end, color in PHASE_SPANS:
                ax.axvspan(start, end, facecolor=color, alpha=0.34, zorder=0)

            panel = summary[
                (summary["metric"] == metric)
                & np.isclose(summary["temperature"], temperature)
            ]
            for speed in SPEEDS:
                speed_data = panel[np.isclose(panel["speed"], speed)].sort_values("time_min")
                for _, item in speed_data.iterrows():
                    draw_interval(ax, item, speed)
                ax.plot(
                    speed_data["time_min"],
                    speed_data["mean"],
                    color=COLORS[speed], marker="o", markersize=4.2,
                    linewidth=1.9, zorder=3, label=f"{speed:.1f} m/s",
                )

            ax.set_xlim(-5, 105)
            ax.set_ylim(*ylim)
            ax.set_yticks(yticks)
            ax.set_xticks(TIME_POINTS)
            ax.grid(axis="y", color="#B8B8B8", linewidth=0.45, alpha=0.35)
            ax.grid(axis="x", visible=False)
            ax.spines["top"].set_visible(False)
            ax.spines["right"].set_visible(False)
            ax.tick_params(axis="both", labelsize=15, length=3, width=0.8)

            if row_idx == 0:
