        max_rel = plot_raw_df["relative_time_raw"].max(skipna=True)

        if max_rel > 300:
            print("Relative numeric time appears to be in seconds. Converted to minutes.")
            plot_raw_df["relative_time_min"] = plot_raw_df["relative_time_raw"] / 60
        elif max_rel <= 2 and plot_raw_df["numeric_time_tmp"].median(skipna=True) > 1000:
